# Backend settings. Copy to .env for local development.

# Local: SQLite file. Production: your Neon connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Signs logins and encrypts users' stored API keys and mailbox passwords.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never change it after users have saved keys.
NEXTAUTH_SECRET=

# Frontend origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:3000
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Protects /api/internal/cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# AI keys are NOT configured here - each user adds their own in Settings -> AI keys.
